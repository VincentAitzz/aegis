# =============================================================================
# Bridge Aegis — configuración desde entorno (.env o variables de proceso)
# =============================================================================

# ¿En qué interfaz escucha el bridge? (dev: 0.0.0.0 para emulador/localhost;
# estricto/red privada virtual: la IP de la tailnet, ej. 100.x.y.z)
BRIDGE_BIND=0.0.0.0
BRIDGE_PORT=8000

# API server de Hermes (loopback — nunca se expone a la malla)
HERMES_BASE_URL=http://127.0.0.1:8642
# La misma clave generada en ~/.hermes/.env (API_SERVER_KEY)
HERMES_API_KEY=secret-generado-antirrombo

# Ollama (loopback del host)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Alias de agente registrados en Hermes (routes del API server)
AGENT_WORKER=worker
AGENT_ORCHESTRATOR=orchestrator

# =============================================================================
# Observabilidad
# =============================================================================
# Directorio base para logs estructurados JSON:
#   <LOG_DIR>/bridge.jsonl  +  <LOG_DIR>/runs/<run_id>.jsonl
LOG_DIR=data/logs

# =============================================================================
# Memoria del proyecto ('cerebro')
# =============================================================================
# Almacén vectorial + grafo conceptual persistidos en disco (nunca en el repo).
MEMORY_ENABLED=true
MEMORY_DIR=data/memory
# Cuántos episodios similares se inyectan como contexto en cada nueva tarea.
MEMORY_RECALL_K=3
# Backend del grafo conceptual: sqlite (stdlib, por defecto) | graphiti (avanzado,
# requiere 'pip install graphiti-core falkordb') | off
MEMORY_GRAPH_BACKEND=sqlite
# Modelo de embeddings local en Ollama (necesario para la memoria episódica).
# Instalación: ollama pull nomic-embed-text
EMBED_MODEL=nomic-embed-text
# =============================================================================
# Neon — Aegis gestiona la topología de las bases de los proyectos.
# Solo la KEY va aquí: las connection strings se piden a Neon por API en el
# momento de usarlas (app/neon.py), para que ninguna contraseña quede en un
# archivo. Ámbito recomendado: organización. Nunca versionar.
NEON_API_KEY=
