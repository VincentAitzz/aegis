# =============================================================================
# Bridge Aegis — configuración desde entorno (.env o variables de proceso)
# =============================================================================

# ¿En qué interfaz escucha el bridge? (dev: 0.0.0.0 para emulador/localhost;
# estricto/red privada virtual: la IP de la tailnet, ej. 100.x.y.z)
BRIDGE_BIND=0.0.0.0
BRIDGE_PORT=8000

# API server de Hermes (loopback — nunca se expone a la malla)
HERMES_BASE_URL=http://127.0.0.1:8642
# La misma clave generada en ~/.hermes/.env (API_SERVER_KEY)
HERMES_API_KEY=secret-generado-antirrombo

# Ollama (loopback del host)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Alias de agente registrados en Hermes (routes del API server)
AGENT_WORKER=worker
AGENT_ORCHESTRATOR=orchestrator