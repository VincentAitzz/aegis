# =============================================================================
# Bridge Aegis — configuración desde entorno (.env o variables de proceso)
# =============================================================================

# ¿En qué interfaz escucha el bridge? (dev: 0.0.0.0 para emulador/localhost;
# estricto/red privada virtual: la IP de la tailnet, ej. 100.x.y.z)
BRIDGE_BIND=0.0.0.0
BRIDGE_PORT=8000

# API server de Hermes (loopback — nunca se expone a la malla)
HERMES_BASE_URL=http://127.0.0.1:8642
# La misma clave generada en ~/.hermes/.env (API_SERVER_KEY)
HERMES_API_KEY=secret-generado-antirrombo

# Ollama (loopback del host)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Alias de agente registrados en Hermes (routes del API server)
AGENT_WORKER=worker
AGENT_ORCHESTRATOR=orchestrator

# =============================================================================
# Observabilidad
# =============================================================================
# Directorio base para logs estructurados JSON:
#   <LOG_DIR>/bridge.jsonl  +  <LOG_DIR>/runs/<run_id>.jsonl
LOG_DIR=data/logs

# =============================================================================
# Memoria del proyecto ('cerebro')
# =============================================================================
# Almacén vectorial + grafo conceptual persistidos en disco (nunca en el repo).
MEMORY_ENABLED=true
MEMORY_DIR=data/memory
# Cuántos episodios similares se inyectan como contexto en cada nueva tarea.
MEMORY_RECALL_K=3
# Backend del grafo conceptual: sqlite (stdlib, por defecto) | graphiti (avanzado,
# requiere 'pip install graphiti-core falkordb') | off
MEMORY_GRAPH_BACKEND=sqlite
# Modelo de embeddings local en Ollama (necesario para la memoria episódica).
# Instalación: ollama pull nomic-embed-text
EMBED_MODEL=nomic-embed-text
# =============================================================================
# Neon — Aegis gestiona la topología de las bases de los proyectos.
# Solo la KEY va aquí: las connection strings se piden a Neon por API en el
# momento de usarlas (app/neon.py), para que ninguna contraseña quede en un
# archivo. Ámbito recomendado: organización. Nunca versionar.
NEON_API_KEY=

# Clave de la API de operación (X-Aegis-Token). VACÍA = sin auth: es lo que hay
# hoy para todo lo existente, y lo nuevo sigue abierto por eso.
#
# Ponle un valor SOLO cuando el móvil ya lo lleve en la cabecera, porque en ese
# momento los endpoints nuevos empiezan a exigirlo y los viejos siguen igual.
# Se gira por nombre versionado: AEGIS_API_KEY_V2 -> AEGIS_API_KEY_V3, y la
# vieja se borra DESPUÉS de que el cliente use la nueva.
AEGIS_API_KEY=

# Serial adb del teléfono, cuando lo declaras tú a mano.
#
# Aegis reconoce un teléfono de tres formas: por el nombre que publica el
# teléfono por mDNS, por `adb connect ip:puerto`, o por este serial. Lo que **no**
# hace es adivinar: un serial USB (`SERIAL1234567`) no se parece a nada de lo
# anterior, y suponer que "el único aparato que no es el emulador es tu teléfono"
# es exactamente el tipo de suposición que acaba instalando una app de prueba en
# un aparato real.
#
# Ponlo cuando conectas el teléfono por USB:
#   adb devices -l | grep -o '^[A-Z0-9]*' | head -1
AEGIS_PHONE_SERIAL=

# IP del bridge para el APK del teléfono, cuando no es la de la tailnet.
#
# El teléfono habla con el bridge por Tailscale. Si ahí no hay Tailscale (o no
# hay salida), pon la IP de la red local y Aegis lo comprueba antes de instalar:
# una app en el teléfono que no ve el bridge no es una app instalada, es un icono.
#   ip -4 addr | grep wlan0
AEGIS_BRIDGE_TAILNET_IP=
