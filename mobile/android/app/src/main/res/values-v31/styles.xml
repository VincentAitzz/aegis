<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+ (Android 12): el splash del sistema.

         El proyecto no tenía nada de esto, así que en Android 12+ el arranque lo
         llevaba el sistema con su propia lógica y el logo no aparecía hasta que
         Flutter pintaba. Con estos atributos lo decide el sistema: fondo negro,
         ícono de Aegis y el mismo negro detrás del ícono, para que el casco no
         quede sobre un disco de otro color.

         El ícono se referencia como `@mipmap/ic_launcher` a propósito: el sistema
         resuelve el ícono **adaptativo** (`mipmap-anydpi-v26`) y lo enmascara con
         su propia forma. Si se apuntara al PNG plano, se vería el cuadrado. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/aegis_black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/aegis_black</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/aegis_bg</item>
    </style>
</resources>