<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Idéntico a `values/styles.xml` a propósito.

         Antes differed solo en el padre (Black en vez de Light) y la app quedaba
         con dos finales distintos según el tema del sistema. Una sola
         definición: el HUD es oscuro siempre. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/aegis_bg</item>
    </style>
</resources>