<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- `POST_NOTIFICATIONS` es obligatorio desde Android 13 (SDK 33) y esta app
         apunta a 36. Sin él, `NotificationManager.notify()` no hace nada y no hay
         error: la notificación simplemente no aparece.

         ## Por qué lo declara la app y no el shell
         Antes el aviso lo posteaba `com.android.shell` con `cmd notification
         post`. Funcionaba en el emulador y fallaba en un Samsung real: el
         `appop` de la app era `ignore` y el aviso no traía ni el icono ni el
         canal de Aegis. Una notificación que postea otro no es una notificación
         tuya, y no se puede abrir en algo tuyo. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- ## Para poder instalar la actualización que descarga
         `REQUEST_INSTALL_PACKAGES` es lo que pide Android el permiso de
         «instalar apps desconocidas», que el móvil concede **a mano** en
         Ajustes → Apps → Acceso especial. Es el precio de que una app pueda
         actualizar a otra sin `adb`, y no hay manera de evitarlo.

         ## Lo que este permiso NO permite
         Instalar en silencio. Android no lo permite en ningún modo: ni como app
         normal, ni siendo device owner sin provisionar por `adb`. Siempre hay un
         diálogo del sistema y siempre hay un toque humano. La app lo dice en la
         pantalla en vez de dejar que aparezca por sorpresa. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <!-- ## Por qué cleartext está declarado
             No es un descuido de seguridad: **es lo que la app ya hacía**.

             Dart habla con el bridge en `http://` sobre la malla privada desde
             el principio, y lo sigue haciendo: la app muestra «puente:
             contesta» contra un `http://` sin TLS. Funciona porque los sockets de
             `dart:io` no pasan por la comprobación de cleartext de Java.

             El overlay nativo y el receptor de avisos sí usan
             `HttpURLConnection`, que **sí la comprueba**, y ahí se comía un
             `IOException: Cleartext HTTP traffic not permitted`. Los dos caminos
             al mismo puente, con políticas distintas, y solo uno lo sabía.

             Un `networkSecurityConfig` acotando `localhost`, `10.0.2.2` y la IP
             de la tailnet sería más estrecho, pero `API_HOST` lo fija quien compila
             y el rango de Tailscale (100.64.0.0/10) no se puede escribir en
             `<domain>`. Un allowlist que se queda corto en cuanto cambia la
             dirección es peor que la regla honesta: falla en el teléfono y no en
             la prueba.

             Declarar la verdad —«esta app habla en claro por una malla privada»—
             deja la política del sistema y la del código diciendo lo mismo. Lo que
             protege esto no es el TLS: es que el bridge exige `X-Aegis-Token` en
             lo que de verdad importa, y que tu tailnet no es la red pública. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- El cuadro de decisión, encima de lo que estés usando.

             ## Por qué una activity aparte y no un diálogo dentro de MainActivity
             Abrir la app para preguntar "¿puedo instalar?" **interrumpe**: te saca
             de lo que estabas haciendo. Con una ventana translúcida el diálogo
             aparece sobre la app que tuvieras y al cerrar el diálogo sigues
             donde estabas. Eso es lo que hace `Theme.AegisOverlay`.

             `noHistory` para que al cerrar no quede en el retroceso, y
             `excludeFromRecents` para que no aparezca en el historial de apps:
             es una ventana, no una app. -->
        <activity
            android:name=".OverlayActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.AegisOverlay"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="false"/>

        <!-- El que publica la notificación de Aegis.

             `exported="true"` porque el puente la despierta con `am broadcast`
             desde adb, que es otro proceso y otro usuario. No es una puerta
             abierta de nada: el receptor **no acepta datos del broadcast**,
             va al bridge a preguntar qué hay pendiente. Que alguien lo dispare
             solo provoca que se lea `/deploys` y se avise, que es idempotente y
             no concede nada. El permiso vive en la respuesta del bridge, no en el
             intent. -->
        <receiver
            android:name=".NotificacionReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.aegis.aegis_console.AVISAR"/>
            </intent-filter>
        </receiver>

        <!-- ## Cómo se le pasa el APK al instalador
             Android 7 cerró los `file://` que salen de una app hacia fuera, así
             que el instalador necesita una URI `content://` y el permiso de
             lectura solo para ese intent. `FileProvider` es lo que la produce.

             `exported=false` porque no hay nada que otra app deba poder abrir.
             `grantUriPermissions=true` es lo que hace que el `FLAG_GRANT_READ_URI_
             PERMISSION` del intent sirva. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.ficheros"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- ## Por qué hay que declarar el instalador
             Desde Android 11 las apps no ven las de otras. Sin esto,
             `PackageManager.resolveActivity()` devuelve `null` y la app cree que
             no hay instalador, dice «no se puede instalar» y **no pasa nada**.

             El fallo aparece como un mensaje razonable sobre un problema que no
             existe, que es la forma más difícil de depurar que hay. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="application/vnd.android.package-archive"/>
        </intent>
    </queries>
</manifest>